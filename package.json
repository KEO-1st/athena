{
  "name": "athena",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "ATHENA — a personal AI that coordinates the machines on your network.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "node": "node node/athena-node.mjs",
    "check": "node tests/check.mjs",
    "test": "node --test tests",
    "test:live": "node --test tests/brain-live.test.mjs",
    "smoke": "node tests/smoke.mjs",
    "package:node": "node tools/package.mjs --only node",
    "package:hub": "node tools/package.mjs --only hub",
    "package": "node tools/package.mjs"
  }
}
