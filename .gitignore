# ── runtime state and secrets ───────────────────────────────────────────────
# data/ holds the access code, the API-key hashes, every paired node token and
# the sessions of unlocked phones. Never commit it.
data/

# a node's own identity and pairing token + its settings
node/config.json
node/state.json
node/screen-frame.jpg

# logs, dumps, leftovers
*.log
*.out
*.err
node/*.log
node/*.out
node/*.err

# ── local / editor noise ────────────────────────────────────────────────────
node_modules/
.env
.env.*
.DS_Store
Thumbs.db
desktop.ini
*.tmp

# built distribution folders and zips (recreate with npm run package)
dist/

# local screenshots, CDP helpers and downloaded build SDKs
.freebuff/
tools/.cache/

# the independent Node product has its own repository
athena-node/
