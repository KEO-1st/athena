; ATHENA // ASTRAL COMMAND
; Native Godot 4 + C# desktop prototype. No WebView, no browser UI.
config_version=5

[application]

config/name="ATHENA // Astral Command"
config/description="Native 3D command environment prototype. Not a browser and not WebView2."
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://assets/athena.ico"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.005, 0.008, 0.018, 1)

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[dotnet]

project/assembly_name="AthenaDesktop"

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=2
environment/defaults/default_clear_color=Color(0.002, 0.004, 0.01, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
